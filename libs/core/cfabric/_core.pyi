def get_cache_dir() -> Path:
    """The per-user cache directory: `CFABRIC_CACHE` when set, else the platform
    cache directory for `cfabric`. Compiled caches of read-only corpora are
    stored here."""

_Silent: TypeAlias = Literal["verbose", "auto", "terse", "deep"] | bool | None
"""Verbosity: `verbose`/`False`, `auto`/`None` (default), `terse`, `deep`/`True`."""
_FeatureNames: TypeAlias = str | Iterable[str]
"""Feature names as a whitespace/comma separated string or an iterable."""
_NodeTypes: TypeAlias = str | Iterable[str]
"""Node type(s): one name or an iterable of names."""
_FeatureValue: TypeAlias = str | int
_Heading: TypeAlias = tuple[tuple[str, str | int | None], ...]
# Aliases for classes whose names `Corpus` reuses for its TF-style members.
_Computeds: TypeAlias = Computeds
_Computed: TypeAlias = Computed
_Locality: TypeAlias = Locality
_Nodes: TypeAlias = Nodes
_Text: TypeAlias = Text
_Search: TypeAlias = Search
_CacheTarget: TypeAlias = int | list[tuple[bool, bool, str]]
"""`0` print, `1` cache and print, `-1` cache only, or a list to append to."""

