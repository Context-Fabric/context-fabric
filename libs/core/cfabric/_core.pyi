@final
class LevView:
    """Lazy sequence backing `C.levUp.data` / `C.levDown.data`.

    Indexed like Text-Fabric's tuples: `C.levUp.data[n - 1]` are the embedders
    of node `n` and `C.levDown.data[n - maxSlot - 1]` the non-slot embeddees of
    non-slot node `n`. `row(n)` reads node `n`'s row directly. Rows are read on
    demand from the mmap to avoid materializing every node's tuple.
    """

    def __getitem__(self, index: int, /) -> tuple[int, ...]: ...
    def row(self, node: int) -> tuple[int, ...]: ...
    def __len__(self) -> int: ...

